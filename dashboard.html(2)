<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>RE:WEAR | Wardrobe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,500&family=Playfair+Display:wght@500;600&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- header -->

    <header class="top-header">

        <div class="logo">
            RE:<span>WEAR</span>
        </div>

        <div class="tagline">
            Rewear. Restyle. Repeat.
        </div>

    </header>


    <div class="app-container">

        <!-- SIDEBAR -->

        <aside class="sidebar">

            <div class="sidebar-title">

                <strong>Your Re:Space</strong>

                <button
                    type="button"
                    class="menu-button"
                    id="menuButton"
                    aria-label="Menu"
                >
                    <span class="material-symbols-outlined">
                        menu
                    </span>
                </button>

            </div>


            <nav class="navigation">

                <button
                    type="button"
                    class="nav-item active"
                    data-page="dashboard.html"
                >

                    <span class="material-symbols-outlined nav-icon">
                        checkroom
                    </span>

                    <span>Wardrobe</span>

                </button>


                <button
                    type="button"
                    class="nav-item"
                    data-page="outfits.html"
                >

                    <span class="material-symbols-outlined nav-icon">
                        styler
                    </span>

                    <span>Outfits</span>

                </button>


                <button
                    type="button"
                    class="nav-item"
                    data-page="calendar.html"
                >

                    <span class="material-symbols-outlined nav-icon">
                        calendar_month
                    </span>

                    <span>Calendar</span>

                </button>


                <button
                    type="button"
                    class="nav-item"
                    data-page="shared-closet.html"
                >

                    <span class="material-symbols-outlined nav-icon">
                        diversity_3
                    </span>

                    <span>Shared Closet</span>

                </button>


                <button
                    type="button"
                    class="nav-item"
                    data-page="profile.html"
                >

                    <span class="material-symbols-outlined nav-icon">
                        person
                    </span>

                    <span>Profile</span>

                </button>

            </nav>


            <button
                type="button"
                class="sign-out"
                id="signOutButton"
            >

                <span class="material-symbols-outlined">
                    logout
                </span>

                <span>Sign Out</span>

            </button>

        </aside>


        <!-- body -->

        <main class="main-content">

            <div class="page-heading">

                <h1>
                    WARDROBE
                    <span>|</span>
                    <em>YOUR COLLECTION</em>
                </h1>

                <button
                    type="button"
                    class="add-button"
                    id="openModal"
                >
                    <span>+</span>
                    Add Item
                </button>

            </div>


            <!-- categories -->

            <div class="category-filters">

                <button
                    type="button"
                    class="category-button active"
                    data-category="All"
                >
                    All Categories
                </button>

                <button
                    type="button"
                    class="category-button"
                    data-category="Top"
                >
                    Top
                </button>

                <button
                    type="button"
                    class="category-button"
                    data-category="Bottom"
                >
                    Bottom
                </button>

                <button
                    type="button"
                    class="category-button"
                    data-category="Dress"
                >
                    Dress
                </button>

                <button
                    type="button"
                    class="category-button"
                    data-category="Outerwear"
                >
                    Outerwear
                </button>

                <button
                    type="button"
                    class="category-button"
                    data-category="Accessories"
                >
                    Accessories
                </button>

                <button
                    type="button"
                    class="category-button"
                    data-category="Shoes"
                >
                    Shoes
                </button>

            </div>


            <!-- items -->

            <section
                class="wardrobe-grid"
                id="wardrobeGrid"
            ></section>


            <!-- when wardrobe is empty -->

            <div
                class="empty-state"
                id="emptyState"
            >

                <span class="material-symbols-outlined empty-icon">
                    checkroom
                </span>

                <h2>
                    Your wardrobe is empty
                </h2>

                <p>
                    Add your first piece to get started.
                </p>

                <button
                    type="button"
                    class="empty-add-button"
                    id="emptyAddButton"
                >
                    + Add your first item
                </button>

            </div>

        </main>

    </div>


    <!-- footer -->

    <footer>

        <div class="footer-links">
            <span>About</span>
            <span>Contact</span>
            <span>Privacy Policy</span>
        </div>

        <div>
            © 2026 RE:WEAR
        </div>

    </footer>


    <!-- item modal -->

    <div
        class="modal-overlay"
        id="modal"
    >

        <div class="modal">

            <button
                type="button"
                class="close-modal"
                id="closeModal"
                aria-label="Close"
            >
                ×
            </button>


            <h2>
                New piece
            </h2>


            <div class="form-group">

                <label>
                    Photo
                </label>


                <div class="photo-options">

                    <label class="photo-button">

                        <span class="material-symbols-outlined">
                            upload
                        </span>

                        Upload photo

                        <input
                            type="file"
                            id="photo"
                            accept="image/*"
                        >

                    </label>


                    <label class="photo-button">

                        <span class="material-symbols-outlined">
                            photo_camera
                        </span>

                        Take photo

                        <input
                            type="file"
                            id="cameraPhoto"
                            accept="image/*"
                            capture="environment"
                        >

                    </label>

                </div>


                <p class="help-text">
                    Upload a photo or take one using your camera.
                </p>


                <div
                    class="image-preview"
                    id="imagePreview"
                ></div>

            </div>


            <div class="form-group">

                <label for="itemName">
                    Name *
                </label>

                <input
                    type="text"
                    id="itemName"
                    placeholder="Linen shirt"
                >

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label for="category">
                        Category *
                    </label>

                    <select id="category">

                        <option value="">
                            Select category
                        </option>

                        <option value="Top">
                            Top
                        </option>

                        <option value="Bottom">
                            Bottom
                        </option>

                        <option value="Dress">
                            Dress
                        </option>

                        <option value="Outerwear">
                            Outerwear
                        </option>

                        <option value="Accessories">
                            Accessories
                        </option>

                        <option value="Shoes">
                            Shoes
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label for="season">
                        Season
                    </label>

                    <select id="season">

                        <option value="">
                            Select season
                        </option>

                        <option>
                            Summer
                        </option>

                        <option>
                            Autumn
                        </option>

                        <option>
                            Winter
                        </option>

                        <option>
                            Spring
                        </option>

                        <option>
                            All Season
                        </option>

                    </select>

                </div>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label for="color">
                        Colour
                    </label>

                    <input
                        type="text"
                        id="color"
                        placeholder="Ivory"
                    >

                </div>


                <div class="form-group">

                    <label for="brand">
                        Brand
                    </label>

                    <input
                        type="text"
                        id="brand"
                        placeholder="Glassons"
                    >

                </div>

            </div>


            <div class="form-group">

                <label for="notes">
                    Notes
                </label>

                <textarea
                    id="notes"
                    placeholder="Anything you want to remember..."
                ></textarea>

            </div>


            <div class="donation-choice">

                <p>
                    What would you like to do with this item?
                </p>


                <div class="keep-donate-buttons">

                    <button
                        type="button"
                        class="choice-button active"
                        id="keepButton"
                    >

                        <span class="material-symbols-outlined">
                            inventory_2
                        </span>

                        Keep

                    </button>


                    <button
                        type="button"
                        class="choice-button"
                        id="donateButton"
                    >

                        <span class="material-symbols-outlined">
                            volunteer_activism
                        </span>

                        Donate

                    </button>

                </div>

            </div>




            <button
                type="button"
                class="save-button"
                id="saveButton"
            >
                Save piece
            </button>


            <div
                class="upload-status"
                id="uploadStatus"
            ></div>

        </div>

    </div>


    <script
        type="module"
        src="script.js"
    ></script>

</body>
</html>
