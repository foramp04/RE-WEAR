import {
    getUserData,
    saveUserData
} from "./storage.js";

import {
    auth,
    onAuthStateChanged
} from "./firebase.js";

let wardrobe = [];

let selectedCategory = "All";

let selectedImage = "";

let itemDestination = "keep";


// elements

const modal =
    document.getElementById("modal");

const openModalButton =
    document.getElementById("openModal");

const emptyAddButton =
    document.getElementById("emptyAddButton");

const closeModalButton =
    document.getElementById("closeModal");

const saveButton =
    document.getElementById("saveButton");

const photoInput =
    document.getElementById("photo");

const cameraPhoto =
    document.getElementById("cameraPhoto");

const imagePreview =
    document.getElementById("imagePreview");

const itemNameInput =
    document.getElementById("itemName");

const categoryInput =
    document.getElementById("category");

const seasonInput =
    document.getElementById("season");

const colorInput =
    document.getElementById("color");

const brandInput =
    document.getElementById("brand");

const notesInput =
    document.getElementById("notes");

const wardrobeGrid =
    document.getElementById("wardrobeGrid");

const emptyState =
    document.getElementById("emptyState");

const categoryButtons =
    document.querySelectorAll(".category-button");

const navItems =
    document.querySelectorAll(".nav-item");

const signOutButton =
    document.getElementById("signOutButton");

const keepButton =
    document.getElementById("keepButton");

const donateButton =
    document.getElementById("donateButton");

const uploadStatus =
    document.getElementById("uploadStatus");


// laod data

function loadWardrobe() {

    wardrobe =
        getUserData(
            "wardrobe",
            []
        );

    renderWardrobe();

}


// save data

function saveWardrobe() {

    const saved =
        saveUserData(
            "wardrobe",
            wardrobe
        );


    if (saved) {

        console.log(
            "Wardrobe saved successfully."
        );

        return true;

    }


    uploadStatus.textContent =
        "Could not save this item. Your browser storage is full.";

    return false;

}


// pop-up

function openModal() {

    modal.classList.add("open");

    document.body.style.overflow = "hidden";

}


function closeModal() {

    modal.classList.remove("open");

    document.body.style.overflow = "";

}


openModalButton.addEventListener(
    "click",
    openModal
);


emptyAddButton.addEventListener(
    "click",
    openModal
);


closeModalButton.addEventListener(
    "click",
    closeModal
);


modal.addEventListener(
    "click",
    event => {

        if (event.target === modal) {

            closeModal();

        }

    }
);


document.addEventListener(
    "keydown",
    event => {

        if (
            event.key === "Escape" &&
            modal.classList.contains("open")
        ) {

            closeModal();

        }

    }
);


// keep/donate buttons

keepButton.addEventListener(
    "click",
    () => {

        itemDestination = "keep";

        keepButton.classList.add("active");

        donateButton.classList.remove("active");

    }
);


donateButton.addEventListener(
    "click",
    () => {

        itemDestination = "donate";

        donateButton.classList.add("active");

        keepButton.classList.remove("active");

    }
);


function handleImage(file) {

    if (!file) return;

    uploadStatus.textContent =
        "Preparing photo...";

    const reader =
        new FileReader();


    reader.onload = event => {

        const img =
            new Image();


        img.onload = () => {

            const MAX_WIDTH = 1200;
            const MAX_HEIGHT = 1200;

            let width =
                img.width;

            let height =
                img.height;

            if (
                width > MAX_WIDTH ||
                height > MAX_HEIGHT
            ) {

                const ratio =
                    Math.min(
                        MAX_WIDTH / width,
                        MAX_HEIGHT / height
                    );

                width =
                    Math.round(
                        width * ratio
                    );

                height =
                    Math.round(
                        height * ratio
                    );

            }

            const canvas =
                document.createElement(
                    "canvas"
                );

            canvas.width =
                width;

            canvas.height =
                height;


            const ctx =
                canvas.getContext("2d");


            ctx.drawImage(
                img,
                0,
                0,
                width,
                height
            );

            selectedImage =
                canvas.toDataURL(
                    "image/jpeg",
                    0.82
                );

            imagePreview.innerHTML = `
                <img
                    src="${selectedImage}"
                    alt="Clothing preview"
                >
            `;

            imagePreview.style.display =
                "block";


            uploadStatus.textContent =
                "Photo ready ✓";

        };


        img.onerror = () => {

            uploadStatus.textContent =
                "Could not load this photo.";

        };


        img.src =
            event.target.result;

    };


    reader.onerror = () => {

        uploadStatus.textContent =
            "There was a problem reading that image.";

    };


    reader.readAsDataURL(file);

}


// upload photo

photoInput.addEventListener(
    "change",
    () => {

        handleImage(
            photoInput.files[0]
        );

    }
);


// camera photo (mobile devices)

cameraPhoto.addEventListener(
    "change",
    () => {

        handleImage(
            cameraPhoto.files[0]
        );

    }
);


// save button

saveButton.addEventListener(
    "click",
    () => {

        const name =
            itemNameInput.value.trim();

        const category =
            categoryInput.value;


        // validate name

        if (!name) {

            alert(
                "Please enter a name for your item."
            );

            return;

        }


        // validate category

        if (!category) {

            alert(
                "Please select a category."
            );

            return;

        }


        // validate image

        if (!selectedImage) {

            alert(
                "Please upload a photo."
            );

            return;

        }


        // create item

        const item = {

            id:
                crypto.randomUUID(),

            name:
                name,

            category:
                category,

            season:
                seasonInput.value,

            color:
                colorInput.value.trim(),

            brand:
                brandInput.value.trim(),

            notes:
                notesInput.value.trim(),

            image:
                selectedImage,

            destination:
                itemDestination,

            createdAt:
                new Date().toISOString(),

            shared:
                itemDestination === "donate"

        };


        // Add item to wardrobe
        wardrobe.push(item);


        // Save to localStorage
        const saved =
            saveWardrobe();


        // If saving failed,
        // don't continue.
        if (!saved) {

            wardrobe =
                wardrobe.filter(
                    existingItem =>
                        existingItem.id !== item.id
                );

            return;

        }


        // shared closrt

        if (
            itemDestination === "donate"
        ) {

            addToSharedCloset(item);

        }


        // reset form and close

        selectedCategory =
            "All";


        categoryButtons.forEach(
            button => {

                button.classList.remove(
                    "active"
                );


                if (
                    button.dataset.category ===
                    "All"
                ) {

                    button.classList.add(
                        "active"
                    );

                }

            }
        );


        resetForm();


        closeModal();


        renderWardrobe();


        if (
            itemDestination === "donate"
        ) {

            alert(
                `"${item.name}" has been added to the Shared Closet.`
            );

        }

    }
);


// shared closet (donated items)

function addToSharedCloset(item) {

    let sharedCloset = [];


    try {

        const saved =
            localStorage.getItem(
                "rewearSharedCloset"
            );

        sharedCloset =
            saved
                ? JSON.parse(saved)
                : [];

    } catch (error) {

        console.error(
            "Could not load Shared Closet:",
            error
        );

        sharedCloset = [];

    }


    // Prevent duplicates
    const alreadyExists =
        sharedCloset.some(
            sharedItem =>
                sharedItem.id === item.id
        );


    if (!alreadyExists) {

        sharedCloset.push({

            id:
                item.id,

            name:
                item.name,

            category:
                item.category,

            season:
                item.season,

            color:
                item.color,

            brand:
                item.brand,

            notes:
                item.notes,

            image:
                item.image,

            owner:
                "You",

            status:
                "available",

            requested:
                false,

            createdAt:
                item.createdAt

        });

    }


    try {

        localStorage.setItem(
            "rewearSharedCloset",
            JSON.stringify(sharedCloset)
        );

    } catch (error) {

        console.error(
            "Could not save Shared Closet:",
            error
        );

    }

}


// reset form

function resetForm() {

    photoInput.value = "";

    cameraPhoto.value = "";

    itemNameInput.value = "";

    categoryInput.value = "";

    seasonInput.value = "";

    colorInput.value = "";

    brandInput.value = "";

    notesInput.value = "";

    selectedImage = "";

    itemDestination = "keep";


    imagePreview.innerHTML = "";

    imagePreview.style.display =
        "none";


    keepButton.classList.add(
        "active"
    );

    donateButton.classList.remove(
        "active"
    );


    uploadStatus.textContent = "";

}


function renderWardrobe() {

    wardrobeGrid.innerHTML = "";

    const keptItems =
        wardrobe.filter(
            item =>
                item.destination !== "donate"
        );


    let filtered =
        keptItems;




    if (
        selectedCategory !== "All"
    ) {

        filtered =
            keptItems.filter(
                item =>
                    item.category ===
                    selectedCategory
            );

    }


    // empty

    if (
        filtered.length === 0
    ) {

        wardrobeGrid.style.display =
            "none";

        emptyState.style.display =
            "block";

        return;

    }


    wardrobeGrid.style.display =
        "grid";

    emptyState.style.display =
        "none";



    filtered.forEach(
        item => {

            const card =
                document.createElement(
                    "article"
                );


            card.className =
                "item-card";


            card.innerHTML = `

                <div class="item-image-container">

                    <img
                        src="${item.image}"
                        class="item-image"
                        alt="${escapeHTML(item.name)}"
                    >

                </div>


                <div class="item-information">

                    <div class="item-name">
                        ${escapeHTML(item.name)}
                    </div>


                    <div class="item-details">

                        ${escapeHTML(item.category)}

                        ${
                            item.color
                                ? " • " +
                                  escapeHTML(item.color)
                                : ""
                        }

                        ${
                            item.brand
                                ? " • " +
                                  escapeHTML(item.brand)
                                : ""
                        }

                    </div>


                    <div class="item-actions">

                        <button
                            type="button"
                            class="delete-button"
                            data-id="${item.id}"
                        >
                            Delete
                        </button>

                    </div>

                </div>

            `;


            wardrobeGrid.appendChild(
                card
            );

        }
    );


    // delete

    document
        .querySelectorAll(
            ".delete-button"
        )
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    () => {

                        const id =
                            button.dataset.id;


                        const item =
                            wardrobe.find(
                                i =>
                                    i.id === id
                            );


                        if (!item) return;


                        if (
                            !confirm(
                                `Delete "${item.name}"?`
                            )
                        ) {

                            return;

                        }


                        wardrobe =
                            wardrobe.filter(
                                i =>
                                    i.id !== id
                            );


                        saveWardrobe();

                        renderWardrobe();

                    }
                );

            }
        );

}


// categories

categoryButtons.forEach(
    button => {

        button.addEventListener(
            "click",
            () => {

                categoryButtons.forEach(
                    btn => {

                        btn.classList.remove(
