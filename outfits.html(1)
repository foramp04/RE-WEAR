<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>RE:WEAR | Outfits</title>

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,500&family=Playfair+Display:wght@500;600&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="outfits.css"
    >

</head>

<body>


<header class="top-header">

    <div class="logo">
        RE:<span>WEAR</span>
    </div>

    <div class="tagline">
        Rewear. Restyle. Repeat.
    </div>

</header>


<div class="app-container">


<aside class="sidebar">

    <div class="sidebar-title">

        <strong>Your Re:Space</strong>

        <button class="menu-button">

            <span class="material-symbols-outlined">
                menu
            </span>

        </button>

    </div>


    <nav class="navigation">

        <button
            class="nav-item"
            data-page="dashboard.html"
        >

            <span class="material-symbols-outlined nav-icon">
                checkroom
            </span>

            Wardrobe

        </button>


        <button
            class="nav-item active"
            data-page="outfits.html"
        >

            <span class="material-symbols-outlined nav-icon">
                styler
            </span>

            Outfits

        </button>


        <button
            class="nav-item"
            data-page="calendar.html"
        >

            <span class="material-symbols-outlined nav-icon">
                calendar_month
            </span>

            Calendar

        </button>


        <button
            class="nav-item"
            data-page="shared-closet.html"
        >

            <span class="material-symbols-outlined nav-icon">
                diversity_3
            </span>

            Shared Closet

        </button>


        <button
            class="nav-item"
            data-page="profile.html"
        >

            <span class="material-symbols-outlined nav-icon">
                person
            </span>

            Profile

        </button>

    </nav>


    <button
        class="sign-out"
        id="signOutButton"
    >

        <span class="material-symbols-outlined">
            logout
        </span>

        Sign Out

    </button>

</aside>


<main class="main-content">

    <div class="page-heading">

        <h1>
            OUTFITS
            <span>|</span>
            <em>YOUR LOOKS</em>
        </h1>


        <button
            class="add-button"
            id="createOutfitButton"
        >

            +

            Create Outfit

        </button>

    </div>


    <section
        class="outfits-grid"
        id="outfitsGrid"
    ></section>


    <div
        class="empty-state"
        id="emptyState"
    >

        <span class="material-symbols-outlined">
            styler
        </span>

        <h2>
            No outfits yet
        </h2>

        <p>
            Create an outfit using pieces from your wardrobe.
        </p>

        <button
            class="empty-add-button"
            id="emptyCreateButton"
        >
            + Create your first outfit
        </button>

    </div>

</main>

</div>


<footer>

    <div class="footer-links">

        <span>About</span>
        <span>Contact</span>
        <span>Privacy Policy</span>

    </div>

    <div>
        © 2026 RE:WEAR
    </div>

</footer>


<!-- create outfit pop-up -->

<div
    class="modal-overlay"
    id="outfitModal"
>

    <div class="outfit-modal">

        <button
            class="close-modal"
            id="closeOutfitModal"
        >
            ×
        </button>


        <h2>
            Create an outfit
        </h2>


        <input
            type="text"
            id="outfitName"
            placeholder="Name your outfit..."
        >


        <p class="creator-help">
            Drag clothing from your wardrobe into the outfit.
        </p>


        <div class="creator-layout">


            <div class="wardrobe-selection">

                <h3>
                    Your wardrobe
                </h3>

                <div
                    class="creator-items"
                    id="creatorItems"
                ></div>

            </div>


            <div class="outfit-drop-zone">

                <h3>
                    Outfit
                </h3>

                <div
                    id="dropZone"
                    class="drop-zone"
                >

                    <span class="material-symbols-outlined">
                        add
                    </span>

                    <p>
                        Drag items here
                    </p>

                </div>

            </div>

        </div>


        <button
            class="save-outfit-button"
            id="saveOutfitButton"
        >
            Save outfit
        </button>


        <p
            class="outfit-error"
            id="outfitError"
        ></p>

    </div>

</div>


<script type="module" src="outfits.js"></script>

</body>
</html>
