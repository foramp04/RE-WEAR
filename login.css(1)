* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --cream: #f7f4ec;
    --brown: #3b2923;
    --brown-light: #68544b;
    --border: #ddd8cd;
    --white: #ffffff;
}

body {
    min-height: 100vh;

    background: var(--cream);

    font-family: "DM Sans", Arial, sans-serif;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 30px;
}

.auth-container {
    width: 100%;
}

.auth-card {
    width: 100%;
    max-width: 440px;

    margin: auto;

    background: white;

    padding: 48px;

    border-radius: 18px;

    text-align: center;
}

.logo {
    font-family: "Playfair Display", Georgia, serif;

    font-size: 42px;

    letter-spacing: 3px;

    color: var(--brown);

    font-weight: 600;
}

.logo span {
    font-weight: 500;
}

.tagline {
    margin-top: 8px;

    color: var(--brown-light);

    font-size: 14px;

    font-style: italic;

    letter-spacing: 1.5px;
}

h1 {
    margin-top: 35px;

    color: var(--brown);

    font-family: "Playfair Display", Georgia, serif;

    font-size: 28px;

    font-weight: 500;
}

.subtitle {
    margin-top: 8px;

    color: #7b716b;

    font-size: 14px;
}

#auth-form {
    margin-top: 30px;

    text-align: left;
}

.input-group {
    margin-bottom: 20px;
}

.input-group label {
    display: block;

    margin-bottom: 8px;

    color: var(--brown);

    font-size: 14px;

    font-weight: 600;
}

.input-group input {
    width: 100%;

    padding: 14px 15px;

    border: 1px solid var(--border);

    border-radius: 9px;

    background: #fffdf8;

    font-family: inherit;

    font-size: 15px;

    outline: none;

    transition: border-color 0.2s;
}

.input-group input:focus {
    border-color: var(--brown);
}

.auth-button {
    width: 100%;

    margin-top: 5px;

    padding: 15px;

    border: none;

    border-radius: 9px;

    background: var(--brown);

    color: white;

    font-family: inherit;

    font-size: 16px;

    font-weight: 600;

    cursor: pointer;

    transition: 0.2s;
}

.auth-button:hover {
    opacity: 0.9;

    transform: translateY(-1px);
}

.auth-button:disabled {
    opacity: 0.6;

    cursor: not-allowed;

    transform: none;
}

.error-message {
    min-height: 20px;

    margin-top: 15px;

    color: #a34237;

    font-size: 13px;

    line-height: 1.4;
}

.toggle-text {
    margin-top: 20px;

    color: #716963;

    font-size: 14px;
}

.toggle-text button {
    border: none;

    background: none;

    color: var(--brown);

    font-family: inherit;

    font-weight: 700;

    cursor: pointer;
}

.toggle-text button:hover {
    text-decoration: underline;
    color: var(--brown-light);
}

@media (max-width: 500px) {

    body {
        padding: 15px;
    }

    .auth-card {
        padding: 35px 25px;
    }

    .logo {
        font-size: 36px;
    }

}

a{
    color: var(--brown);
    text-decoration: underline;
}
