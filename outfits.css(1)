@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0');

:root {
    --cream: #f7f4ec;
    --brown: #3b2923;
    --brown-light: #68544b;
    --border: #ddd8cd;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;

    background: var(--cream);

    color: var(--brown);

    font-family: "DM Sans", sans-serif;

    display: flex;

    flex-direction: column;
}

.top-header {
    min-height: 92px;

    background: white;

    border-bottom: 1px solid var(--border);

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 48px;
}

.logo {
    font-family: "Playfair Display", serif;

    font-size: 32px;

    letter-spacing: 2px;
}

.tagline {
    color: var(--brown-light);

    font-style: italic;

    letter-spacing: 2px;
}

.app-container {
    flex: 1;

    display: flex;

    min-height: 0;
}

.sidebar {
    width: 285px;

    flex-shrink: 0;

    background: #eae5d7;

    padding: 28px 20px;

    display: flex;

    flex-direction: column;
}

.sidebar-title {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 30px;

    font-size: 20px;
}

.menu-button {
    border: none;

    background: transparent;

    cursor: pointer;
}

.navigation {
    display: flex;

    flex-direction: column;

    gap: 8px;
}

.nav-item,
.sign-out {
    border: none;

    background: transparent;

    color: #665952;

    padding: 13px 16px;

    border-radius: 9px;

    display: flex;

    align-items: center;

    gap: 12px;

    font-family: inherit;

    font-size: 16px;

    cursor: pointer;

    text-align: left;
}

.nav-item {
    width: 100%;
}

.nav-item:hover,
.sign-out:hover {
    background: rgba(59, 41, 35, 0.08);
}

.nav-item.active {
    background: var(--brown);

    color: white;
}

.sign-out {
    margin-top: auto;

    width: 100%;
}

.main-content {
    flex: 1;

    padding: 55px;

    overflow-y: auto;
}

.page-heading {
    display: flex;

    justify-content: space-between;

    align-items: center;

    margin-bottom: 40px;
}

h1 {
    font-family: "Playfair Display", serif;

    font-size: 30px;

    letter-spacing: 2px;
}

h1 span {
    color: #aaa;

    margin: 0 8px;
}

h1 em {
    font-style: normal;

    font-weight: 400;
}

.add-button,
.empty-add-button,
.save-outfit-button {
    border: none;

    background: var(--brown);

    color: white;

    padding: 14px 22px;

    border-radius: 9px;

    font-family: inherit;

    cursor: pointer;
}

.outfits-grid {
    display: grid;

    grid-template-columns:
        repeat(auto-fill, minmax(270px, 1fr));

    gap: 30px;
}

.outfit-card {
    background: white;

    border-radius: 10px;

    overflow: hidden;

    box-shadow:
        0 4px 15px rgba(59, 41, 35, 0.08);
}

.outfit-images {
    height: 280px;

    background: #eee9dd;

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 2px;
}

.outfit-images img {
    width: 100%;

    height: 100%;

    object-fit: cover;
}

.outfit-information {
    padding: 18px;
}

.outfit-information h3 {
    font-family: "Playfair Display", serif;

    font-size: 20px;

    margin-bottom: 5px;
}

.outfit-information p {
    color: #81766f;

    font-size: 13px;
}

.delete-outfit {
    margin-top: 15px;

    border: none;

    background: transparent;

    color: #8a7770;

    font-family: inherit;

    cursor: pointer;
}

.delete-outfit:hover {
    color: #a83b32;
}

.empty-state {
    text-align: center;

    padding: 100px 20px;

    color: #827771;
}

.empty-state .material-symbols-outlined {
    font-size: 50px;

    margin-bottom: 15px;
}

.empty-state h2 {
    font-family: "Playfair Display", serif;

    font-weight: 500;

    margin-bottom: 8px;
}

.empty-add-button {
    margin-top: 20px;
}

.modal-overlay {
    position: fixed;

    inset: 0;

    background: rgba(0, 0, 0, 0.68);

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    z-index: 999;
}

.modal-overlay.open {
    display: flex;
}

.outfit-modal {
    width: 100%;

    max-width: 1000px;

    max-height: 90vh;

    overflow-y: auto;

    background: #faf7ef;

    border-radius: 14px;

    padding: 40px;

    position: relative;
}

.outfit-modal h2 {
    font-family: "Playfair Display", serif;

    font-size: 35px;

    margin-bottom: 20px;
}

.close-modal {
    position: absolute;

    top: 20px;

    right: 25px;

    border: none;

    background: none;

    font-size: 32px;

    cursor: pointer;
}

#outfitName {
    width: 100%;

    padding: 14px;

    border: 1px solid var(--border);

    border-radius: 8px;

    font-family: inherit;

    background: white;
}

.creator-help {
    margin: 12px 0 25px;

    color: #7d726b;

    font-size: 14px;
}

.creator-layout {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 25px;
}

.creator-layout h3 {
    margin-bottom: 12px;

    font-family: "Playfair Display", serif;
}

.creator-items {
    min-height: 350px;

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 12px;

    padding: 15px;

    background: white;

    border: 1px solid var(--border);

    border-radius: 9px;
}

.creator-item {
    background: #f1ede4;

    border-radius: 7px;

    padding: 7px;

    cursor: grab;
}

.creator-item img {
    width: 100%;

    height: 130px;

    object-fit: cover;

    border-radius: 5px;
}

.creator-item span {
    display: block;

    margin-top: 6px;

    font-size: 12px;
}

.creator-empty {
    grid-column: 1 / -1;

    align-self: center;

    text-align: center;

    color: #81766f;
}

.drop-zone {
    min-height: 350px;

    padding: 15px;

    border: 2px dashed #c9c0b3;

    border-radius: 10px;

    background: #f4f0e7;

    display: flex;

    flex-wrap: wrap;

    align-content: flex-start;

    gap: 10px;
}

.drop-zone.drag-over {
    border-color: var(--brown);
}

.drop-zone > .material-symbols-outlined,
.drop-zone > p {
    width: 100%;

    text-align: center;

    color: #8b817a;

    margin-top: 100px;
}

.selected-item {
    width: 120px;

    height: 150px;

    position: relative;

    background: white;

    padding: 5px;

    border-radius: 7px;
}

.selected-item img {
    width: 100%;

    height: 100%;

    object-fit: cover;

    border-radius: 5px;
}

.selected-item button {
    position: absolute;

    top: 5px;

    right: 5px;

    border: none;

    background: white;

    border-radius: 50%;

    width: 25px;

    height: 25px;

    cursor: pointer;
}

.save-outfit-button {
    margin: 25px 0 0 auto;

    display: block;
}

.outfit-error {
    text-align: right;

    margin-top: 10px;

    color: #a33d34;

    font-size: 13px;
}

footer {
    min-height: 58px;

    background: #777472;

    color: white;

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding: 0 48px;

    font-size: 14px;
}

.footer-links {
    display: flex;

    gap: 40px;
}

@media (max-width: 800px) {

    .top-header {
        padding: 0 20px;
    }

    .tagline {
        display: none;
    }

    .app-container {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;

        padding: 15px;
    }

    .navigation {
        flex-direction: row;

        overflow-x: auto;
    }

    .nav-item {
        width: auto;

        flex-shrink: 0;
    }

    .main-content {
        padding: 30px 20px;
    }

    .page-heading {
        flex-direction: column;

        align-items: flex-start;

        gap: 20px;
    }

    .creator-layout {
        grid-template-columns: 1fr;
    }

    footer {
        padding: 20px;

        flex-direction: column;

        gap: 15px;
    }

}
