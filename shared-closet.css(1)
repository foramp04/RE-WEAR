@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0');

:root {
    --cream: #f7f4ec;
    --brown: #3b2923;
    --brown-light: #68544b;
    --border: #ddd8cd;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;

    background: var(--cream);

    color: var(--brown);

    font-family: "DM Sans", sans-serif;

    display: flex;

    flex-direction: column;
}

.top-header {
    min-height: 92px;

    background: white;

    border-bottom: 1px solid var(--border);

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 48px;
}

.logo {
    font-family: "Playfair Display", serif;

    font-size: 32px;

    letter-spacing: 2px;
}

.tagline {
    color: var(--brown-light);

    font-style: italic;

    letter-spacing: 2px;
}

.app-container {
    flex: 1;

    display: flex;
}

.sidebar {
    width: 285px;

    flex-shrink: 0;

    background: #eae5d7;

    padding: 28px 20px;

    display: flex;

    flex-direction: column;
}

.sidebar-title {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 30px;

    font-size: 20px;
}

.menu-button {
    border: none;

    background: transparent;

    cursor: pointer;
}

.navigation {
    display: flex;

    flex-direction: column;

    gap: 8px;
}

.nav-item,
.sign-out {
    border: none;

    background: transparent;

    color: #665952;

    padding: 13px 16px;

    border-radius: 9px;

    display: flex;

    align-items: center;

    gap: 12px;

    font-family: inherit;

    font-size: 16px;

    cursor: pointer;
}

.nav-item {
    width: 100%;

    text-align: left;
}

.nav-item:hover,
.sign-out:hover {
    background: rgba(59, 41, 35, 0.08);
}

.nav-item.active {
    background: var(--brown);

    color: white;
}

.sign-out {
    margin-top: auto;

    width: 100%;
}

.main-content {
    flex: 1;

    padding: 55px;

    overflow-y: auto;
}

.page-heading h1 {
    font-family: "Playfair Display", serif;

    font-size: 30px;

    letter-spacing: 2px;
}

.page-heading h1 span {
    color: #aaa;

    margin: 0 8px;
}

.page-heading h1 em {
    font-style: normal;

    font-weight: 400;
}

.page-heading p {
    margin-top: 8px;

    color: #7b716b;
}

.shared-tabs {
    display: flex;

    gap: 8px;

    margin-top: 35px;

    border-bottom: 1px solid var(--border);
}

.shared-tab {
    border: none;

    background: transparent;

    padding: 13px 22px;

    color: #776d67;

    font-family: inherit;

    font-size: 15px;

    cursor: pointer;

    border-bottom: 3px solid transparent;
}

.shared-tab:hover {
    color: var(--brown);
}

.shared-tab.active {
    color: var(--brown);

    border-bottom-color: var(--brown);

    font-weight: 600;
}

.shared-tab-content {
    display: none;

    padding-top: 35px;
}

.shared-tab-content.active {
    display: block;
}

.shared-grid {
    display: grid;

    grid-template-columns:
        repeat(auto-fill, minmax(220px, 1fr));

    gap: 28px;
}

.shared-item-card {
    background: white;

    border-radius: 9px;

    overflow: hidden;

    box-shadow:
        0 4px 15px rgba(59, 41, 35, 0.07);
}

.shared-image-wrapper {
    aspect-ratio: 0.82;

    background: #eee9dd;
}

.shared-item-image {
    width: 100%;

    height: 100%;

    object-fit: cover;
}

.shared-item-info {
    padding: 17px;
}

.shared-item-info h3 {
    font-family: "Playfair Display", serif;

    font-size: 19px;

    margin-bottom: 5px;
}

.shared-item-info p {
    color: #756c67;

    font-size: 13px;
}

.request-button {
    width: 100%;

    margin-top: 15px;

    padding: 11px;

    border: none;

    border-radius: 7px;

    background: var(--brown);

    color: white;

    font-family: inherit;

    cursor: pointer;
}

.request-button.requested {
    background: #d5d0c6;

    color: #6c655f;

    cursor: default;
}

.shared-empty {
    min-height: 350px;

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    color: #827771;
}

.shared-empty .material-symbols-outlined {
    font-size: 50px;

    margin-bottom: 15px;
}

.shared-empty h2 {
    font-family: "Playfair Display", serif;

    font-weight: 500;

    margin-bottom: 7px;
}

.request-list {
    display: flex;

    flex-direction: column;

    gap: 15px;
}

.my-request-card,
.incoming-request-card {
    background: white;

    border-radius: 10px;

    padding: 18px;

    display: flex;

    align-items: center;

    gap: 20px;

    box-shadow:
        0 4px 15px rgba(59, 41, 35, 0.06);
}

.my-request-card img,
.incoming-request-card img {
    width: 90px;

    height: 90px;

    object-fit: cover;

    border-radius: 7px;
}

.request-info {
    flex: 1;
}

.request-info h3,
.incoming-request-card h3 {
    font-family: "Playfair Display", serif;

    font-size: 19px;

    margin-bottom: 5px;
}

.request-info p,
.incoming-request-card p {
    color: #7b716b;

    font-size: 13px;

    margin-bottom: 10px;
}

.awaiting {
    display: inline-flex;

    align-items: center;

    gap: 5px;

    color: #776c65;

    font-size: 12px;
}

.awaiting .material-symbols-outlined {
    font-size: 17px;
}

.modal-overlay {
    position: fixed;

    inset: 0;

    background: rgba(0, 0, 0, 0.68);

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    z-index: 999;
}

.modal-overlay.open {
    display: flex;
}

.request-modal {
    width: 100%;

    max-width: 480px;

    background: #faf7ef;

    border-radius: 14px;

    padding: 40px;

    position: relative;
}

.request-modal h2 {
    font-family: "Playfair Display", serif;

    font-size: 30px;

    margin-bottom: 25px;
}

.close-modal {
    position: absolute;

    top: 18px;

    right: 24px;

    border: none;

    background: none;

    font-size: 32px;

    cursor: pointer;
}

.modal-item-preview {
    background: white;

    padding: 12px;

    border-radius: 9px;

    display: flex;

    align-items: center;

    gap: 15px;
}

.modal-item-preview img {
    width: 90px;

    height: 90px;

    object-fit: cover;

    border-radius: 6px;
}

.modal-item-preview strong {
    font-family: "Playfair Display", serif;

    font-size: 18px;
}

.modal-item-preview p {
    margin-top: 5px;

    color: #7b716b;

    font-size: 13px;
}

.request-help {
    margin: 18px 0;

    color: #766c65;

    font-size: 13px;
}

.confirm-request {
    width: 100%;

    padding: 14px;

    border: none;

    background: var(--brown);

    color: white;

    border-radius: 8px;

    font-family: inherit;

    cursor: pointer;
}

footer {
    min-height: 58px;

    background: #777472;

    color: white;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 48px;

    font-size: 14px;
}

.footer-links {
    display: flex;

    gap: 40px;
}

@media (max-width: 800px) {

    .top-header {
        padding: 0 20px;
    }

    .tagline {
        display: none;
    }

    .app-container {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;

        padding: 15px;
    }

    .navigation {
        flex-direction: row;

        overflow-x: auto;
    }

    .nav-item {
        width: auto;

        flex-shrink: 0;
    }

    .main-content {
        padding: 30px 20px;
    }

    .my-request-card,
    .incoming-request-card {
        align-items: flex-start;
    }

    footer {
        padding: 20px;

        flex-direction: column;

        gap: 15px;
    }

}
